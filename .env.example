# ---- Required from M1 -------------------------------------------------
SEC_USER_AGENT="llm-text-alpha research you@example.com" # REQUIRED. SEC fair-access User-Agent with contact email
SEC_MAX_RPS=8 # optional, default 8; hard ceiling 10 (SEC fair-access limit)
DATA_ROOT=~/data/llm-text-alpha # REQUIRED. Data root inside the WSL ext4 filesystem, never /mnt/* (~ expanded by the settings loader)
DATA_DIR= # optional; empty = DATA_ROOT
LOG_LEVEL=INFO # optional: DEBUG|INFO|WARNING
PRICE_PROVIDER=auto # optional: auto|efp|sharadar|crsp|free (D-01 resolved: Sharadar, directly or via efp)

# ---- Prices / fundamentals (per D-01: Sharadar primary) ---------------
SHARADAR_API_KEY= # REQUIRED: Sharadar's direct API (owner's subscription, P-05)
WRDS_USERNAME= # optional (P-04); only for I/B/E/S, Capital IQ transcripts or PRICE_PROVIDER=crsp
EFP_DATA_DIR= # optional; equity-factor-pipeline data root (e.g. ~/data/equity-factor-pipeline) if its data layer exists

# ---- LLM scoring (required from M4) -----------------------------------
ANTHROPIC_API_KEY= # required for provider=anthropic (P-02); never logged
LLM_BUDGET_USD=25 # REQUIRED from M4. Total project cap; spend tracker hard-stops above it
LLM_PROVIDER=anthropic # anthropic|local|fake (fake = deterministic test double, no network)
LLM_CACHE_DIR=./data/llm_cache # optional; response cache + spend ledger location

# ---- Local open-weight model (required from M6) -----------------------
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1 # llama.cpp llama-server or vLLM OpenAI-compatible endpoint
LOCAL_LLM_MODEL=llama-3.1-8b-instruct-q4_k_m # served model name; must match configs/models.yaml
HF_TOKEN= # optional for FinBERT; required to download gated Llama weights (P-08)
TORCH_DEVICE=auto # auto|cpu|cuda

# ---- Optional paid / licensed sources (default: not approved) ---------
TIINGO_API_KEY= # optional; only for news ingest if D-08 is approved (paid). Not needed for prices (the Stooq snapshot covers the D-01 (d) fallback)

# ---- Local Stooq snapshot (P-17; fallback/cross-check prices) ---------
STOOQ_DIR=/mnt/e/trading-strategy-brainstorm/data/stooq # owner-supplied Stooq bulk daily snapshot (d_us_txt, d_world_txt; through 2026-10-30). Read once, converted to Parquet under data/. Native Windows: E:\trading-strategy-brainstorm\data\stooq
